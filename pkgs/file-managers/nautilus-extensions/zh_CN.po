# ── 右键菜单（nautilus-image-converter.c）──
msgid "_Resize Images..."
msgstr "调整图片大小(_R)..."

msgid "Resize each selected image"
msgstr "调整每张选中图片的大小"

msgid "Ro_tate Images..."
msgstr "旋转图片(_T)..."

msgid "Rotate each selected image"
msgstr "旋转每张选中的图片"

msgid "Convert _Format..."
msgstr "转换格式(_F)..."

msgid "Convert format of each selected image"
msgstr "转换每张选中图片的格式"

# ── 通用按钮 ──
msgid "_Skip"
msgstr "跳过(_S)"

msgid "_Retry"
msgstr "重试(_R)"

msgid "_Cancel"
msgstr "取消(_C)"

# ── resizer ──
msgid "Resizing…"
msgstr "正在调整大小…"

#, c-format
msgid "Resizing image: %d of %d"
msgstr "正在调整图片大小：%d / %d"

#, c-format
msgid "<i>Resizing \"%s\"</i>"
msgstr "<i>正在调整 \"%s\" 的大小</i>"

msgid "Please enter a valid filename suffix!"
msgstr "请输入有效的文件名后缀！"

# ── rotator ──
msgid "Rotating…"
msgstr "正在旋转…"

#, c-format
msgid "Rotating image: %d of %d"
msgstr "正在旋转图片：%d / %d"

#, c-format
msgid "<i>Rotating \"%s\"</i>"
msgstr "<i>正在旋转 \"%s\"</i>"

# ── format changer ──
msgid "Converting…"
msgstr "正在转换…"

#, c-format
msgid "Converting image: %d of %d"
msgstr "正在转换图片：%d / %d"

#, c-format
msgid "<i>Converting \"%s\"</i>"
msgstr "<i>正在转换 \"%s\"</i>"

msgid "Combining images into PDF..."
msgstr "正在合并为 PDF..."

msgid "<i>Please wait...</i>"
msgstr "<i>请稍候...</i>"

msgid "Failed to combine images into a PDF. Check whether you have permission to write to this folder."
msgstr "合并为 PDF 失败。请检查是否有该文件夹的写入权限。"

#, c-format
msgid "'%s' cannot be converted. Check whether you have permission to write to this folder."
msgstr "'%s' 无法转换。请检查是否有该文件夹的写入权限。"

# ── resize 对话框（.ui）──
msgid "_Resize"
msgstr "调整(_R)"

msgid "Combine into single PDF document"
msgstr "合并为单个 PDF 文档"

msgid "_Convert"
msgstr "转换(_C)"

msgid "_Rotate"
msgstr "旋转(_R)"

msgid ".resized"
msgstr ".resized"

msgid ".rotated"
msgstr ".rotated"

msgid "<b>Filename</b>"
msgstr "<b>文件名</b>"

msgid "<b>Image Size</b>"
msgstr "<b>图片大小</b>"

msgid "Append"
msgstr "追加"

msgid "Custom size:"
msgstr "自定义大小："

msgid "Height:"
msgstr "高度："

msgid "Resize Images"
msgstr "调整图片大小"

msgid "Resize in place"
msgstr "原地调整（不改文件名）"

msgid "Scale:"
msgstr "缩放："

msgid "Select a size:"
msgstr "选择大小："

msgid "Width:"
msgstr "宽度："

msgid "percent"
msgstr "百分比"

msgid "pixels"
msgstr "像素"

msgid "to file title"
msgstr "到文件名末尾"

# ── 尺寸下拉框数值（保持原样，仅占位）──
msgid "96x96"
msgstr "96x96"

msgid "128x128"
msgstr "128x128"

msgid "640x480"
msgstr "640x480"

msgid "800x600"
msgstr "800x600"

msgid "1024x768"
msgstr "1024x768"

msgid "1280x960"
msgstr "1280x960"

msgid "Compress images to approximately hit a target file size in KB or MB."
msgstr "压缩图片，使文件大小尽量接近指定的 KB / MB 目标值。"

msgid "Append dummy zero-bytes if the compressed image is smaller than the target size (useful for strict portals that mandate a minimum file size)."
msgstr "若压缩后小于目标大小，则追加空字节补足（用于强制最小文件大小的上传限制）。"

msgid "(optional suffix, e.g. .converted)"
msgstr "（可选后缀，例如 .converted）"

# ── 目标大小单位（保持原样）──
msgid "KB"
msgstr "KB"

msgid "MB"
msgstr "MB"

msgid "90° clockwise"
msgstr "顺时针 90°"

msgid "90° counter-clockwise"
msgstr "逆时针 90°"

msgid "180°"
msgstr "180°"

# ── rotate 对话框（.ui）──
msgid ""
"90° clockwise\n"
"90° counter-clockwise\n"
"180°"
msgstr ""
"顺时针 90°\n"
"逆时针 90°\n"
"180°"

msgid "<b>Image Rotation</b>"
msgstr "<b>图片旋转</b>"

msgid "Custom angle:"
msgstr "自定义角度："

msgid "Rotate Images"
msgstr "旋转图片"

msgid "Rotate in place"
msgstr "原地旋转（不改文件名）"

msgid "Select an angle:"
msgstr "选择角度："

msgid "degrees clockwise"
msgstr "度（顺时针）"

# ── format 对话框（.ui，下拉格式名保留英文以便识别）──
msgid "Convert Image Format"
msgstr "转换图片格式"

msgid "<b>Target Format</b>"
msgstr "<b>目标格式</b>"

msgid "Select format:"
msgstr "选择格式："

msgid "Delete original file after conversion"
msgstr "转换后删除原文件"

msgid "Target size (approx.):"
msgstr "目标大小（约）："

msgid "Pad with dummy bytes if smaller than target"
msgstr "小于目标时用空字节填充"

msgid "AVIF (.avif)"
msgstr "AVIF (.avif)"

msgid "GIF (.gif)"
msgstr "GIF (.gif)"

msgid "JPEG (.jpg)"
msgstr "JPEG (.jpg)"

msgid "PDF (.pdf)"
msgstr "PDF (.pdf)"

msgid "PNG (.png)"
msgstr "PNG (.png)"

msgid "WebP (.webp)"
msgstr "WebP (.webp)"
