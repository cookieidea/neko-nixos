#!/usr/bin/env bash
# shorin-screenrec-menu —— 录屏菜单（gpu-screen-recorder + fuzzel）
# 对应 binds.kdl 的 Mod+F3「录屏 Screen record」。
# 依赖：gpu-screen-recorder、fuzzel、notify-send（libnotify）
set -euo pipefail

OUT_DIR="${XDG_VIDEOS_DIR:-$HOME/Videos}/Recordings"
mkdir -p "$OUT_DIR"

STOP_OPTION="■ 停止录屏  Stop recording"
OPTS=(
  "区域录屏（无音）  Region · no audio"
  "区域录屏（麦克风）Region · mic"
  "全屏录屏（无音）  Fullscreen · no audio"
  "全屏录屏（麦克风）Fullscreen · mic"
  "窗口录屏（麦克风）Window · mic"
)

# 录制中：菜单直接给停止项
if pgrep -x gpu-screen-recorder >/dev/null 2>&1; then
  CHOICE=$(printf "%s\n" "$STOP_OPTION" | fuzzel --dmenu --width=52 --prompt="Screen Recorder > " 2>/dev/null || true)
  case "$CHOICE" in
    "$STOP_OPTION")
      pkill -x gpu-screen-recorder
      notify-send -a "screenrec" "已停止录屏" "文件已保存到 $OUT_DIR" 2>/dev/null || true
      ;;
  esac
  exit 0
fi

CHOICE=$(printf "%s\n" "${OPTS[@]}" | fuzzel --dmenu --width=52 --prompt="Screen Recorder > " 2>/dev/null || true)
[[ -z "$CHOICE" ]] && exit 0

STAMP=$(date +%Y-%m-%d_%H-%M-%S)
OUT="$OUT_DIR/rec_$STAMP.mp4"

case "$CHOICE" in
  "${OPTS[0]}") ARGS=(-w region -a none) ;;
  "${OPTS[1]}") ARGS=(-w region -a default) ;;
  "${OPTS[2]}") ARGS=(-w screen -a none) ;;
  "${OPTS[3]}") ARGS=(-w screen -a default) ;;
  "${OPTS[4]}") ARGS=(-w window -a default) ;;
  *) exit 0 ;;
esac

# gpu-screen-recorder：region/window 模式会在录制开始时弹出交互选框
setsid gpu-screen-recorder "${ARGS[@]}" -c mp4 -f 60 -o "$OUT" >/dev/null 2>&1 &
disown 2>/dev/null || true
notify-send -a "screenrec" "开始录屏" "$CHOICE → $OUT" 2>/dev/null || true
