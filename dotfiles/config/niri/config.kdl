// =============================================================
// niri 配置（迁移自 NyxNiri ech678/NyxNiri，v2/niri）
// 已针对 NixOS 适配：保留原 Shorin 的 fcitx5/xsettingsd/xhost/mpvpaper 等自启，
// 桌面 shell 改用 Noctalia V5（nixpkgs/flake 的 noctalia 包）。
// 快捷键绑定保留本机原有的 binds.kdl（仅 IPC 命令适配 V5）。
// =============================================================

// 引入由 nwg-displays 生成的显示器配置（本机手写 monitor.kdl）
include "monitor.kdl"
// 动态引入视觉特效样式 (普通模式 vs 护眼模式)
include "effects.kdl"
// 引入输入设备与手势配置
include optional=true "input__custom__.kdl"
// 引入布局设置
include "layout.kdl"
// 引入动画配置
include "animations.kdl"
// 引入窗口与图层规则
include "rules.kdl"
// 引入快捷键绑定配置
include "binds.kdl"
// 光标配置
include "cursor.kdl"

overview {
    backdrop-color "#4c566a90"
    workspace-shadow {
        off
    }
}

environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    // 界面语言
    LANGUAGE "zh_CN:en"
    LANG "zh_CN.UTF-8"
    // 输入法环境变量
    XMODIFIERS "@im=fcitx"
    // qt 主题
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_QPA_PLATFORMTHEME_QT6 "gtk3"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    // 默认文本编辑器
    EDITOR "vim"

    // NVIDIA environment variables（本机为 AMD/核显时保持注释）
    // GBM_BACKEND "nvidia-drm"
    // __GLX_VENDOR_LIBRARY_NAME "nvidia"
    // LIBVA_DRIVER_NAME "nvidia"
}

// ── 自动启动 ──
// Noctalia V5 桌面 shell（原生 C++，替代 v4 noctalia-shell）
spawn-at-startup "noctalia"

// 护眼模式同步（对齐 effects.kdl 软链接状态）
spawn-at-startup "~/.config/niri/scripts/toggle-eyecare.sh" "--sync"

// 输入法
spawn-at-startup "fcitx5"

// GTK 主题/字体经 XSETTINGS 注入应用（niri 无 DE，靠它让 Thunar 等 GTK 程序统一主题）
spawn-at-startup "xsettingsd"

// 允许 root 通过用户的 xwayland 打开窗口
spawn-at-startup "xhost" "+si:localuser:root"

// X11 兼容层：xwayland-satellite（niri 25.08+ 开箱集成，binary 在 PATH 时按需拉起）
xwayland-satellite {
}

// 设置会话类环境变量（NixOS 上 systemctl 可用）
spawn-sh-at-startup "systemctl --user set-environment XDG_SESSION_CLASS=user"

// 截图音效守护进程（SHORiN 私有脚本）
spawn-at-startup "~/.config/niri/scripts/screenshot-sound.sh"

// 视频壁纸：由 Noctalia V5 的 noctalia/mpvpaper 插件管理（config.toml 里
// video_directory 指向 ~/Pictures/Wallpapers/video），不再直接 spawn mpvpaper。
// spawn-at-startup "mpvpaper" ... （已移除）

// 取消启动 niri 时自动开启快捷键教程
hotkey-overlay {
    skip-at-startup
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

debug {
    honor-xdg-activation-with-invalid-serial
}

recent-windows {
    binds {
        Alt+Tab         { next-window scope="output"; }
        Alt+Shift+Tab   { previous-window scope="output"; }
        Alt+grave       { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
    highlight {
        corner-radius 12
        active-color "#b6c7e7"
        urgent-color "#ffb4ab"
    }
}

// ==========================================================
// 用户自定义配置（更新时自动保留）
// ==========================================================
include "__custom__.kdl"